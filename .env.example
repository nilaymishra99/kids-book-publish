# Copy to .env for `vercel dev`, or set these in Vercel → Project Settings →
# Environment Variables. Never commit the real .env file.
# Everything is optional: with nothing set the site runs in photo-comic
# mode, uses the template stories, and ordering shows "opening soon".

# --- Images and face finding (Google Gemini) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# IMAGE_MODEL=gemini-3.1-flash-image      # check the current id in AI Studio
# DETECT_MODEL=gemini-2.5-flash
# IMAGE_PROVIDER=gemini                    # or "openai" (then set OPENAI_API_KEY)
# OPENAI_API_KEY=

# --- Stories (Anthropic Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=
# STORY_MODEL=claude-sonnet-5-5

# --- Payments: https://dashboard.stripe.com/apikeys (use sk_test_... first) ---
STRIPE_SECRET_KEY=
# SITE_URL=https://www.your-domain.com   # defaults to the request host

# Local testing only: lets you finish an "order" without Stripe.
# Leave unset/false in production.
ALLOW_DEMO_CHECKOUT=true

# --- Print orders: add a Blob store in Vercel → Storage; this is set for you ---
BLOB_READ_WRITE_TOKEN=

# --- Order notification emails (https://resend.com) ---
RESEND_API_KEY=
# ORDERS_TO_EMAIL=mail2nilaymishra@gmail.com
# ORDERS_FROM_EMAIL=Comic Orders <onboarding@resend.dev>
